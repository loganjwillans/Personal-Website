# Copy to .env and fill in real values.
#
# One variable per protected case study, named after its file in
# src/content/work (uppercased, punctuation becomes underscores):
#   my-case-study.mdx → CASE_STUDY_PASSWORD_MY_CASE_STUDY
#
# For GitHub Pages deploys, add the same names as repository secrets:
# Settings → Secrets and variables → Actions → New repository secret

CASE_STUDY_PASSWORD_CONTRACT_INTAKE_REBUILD=change-me
