---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkCard from '@/components/WorkCard.astro';
import PostCard from '@/components/PostCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { site } from '@/config';
import { hashTilt, markerStyle, pinStyle, tiltStyle, viewName } from '@/lib/tilt';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((entry) => entry.data.featured);
const selected = (featured.length > 0 ? featured : work).slice(0, 2);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const heroTilt = tiltStyle(hashTilt('hero'));
const workPin = pinStyle(hashTilt('section-work'));
const projectsPin = pinStyle(hashTilt('section-projects'));
const writingPin = pinStyle(hashTilt('section-writing'));

// Page-scoped names: nothing on this page can pair with another page's copy.
const vtHead = viewName(Astro.url.pathname, 'head');
const vtWork = viewName(Astro.url.pathname, 'banner-work');
const vtProjects = viewName(Astro.url.pathname, 'banner-projects');
const vtWriting = viewName(Astro.url.pathname, 'banner-writing');
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div
        class="hero-sheet sheet tilt stack pin pin--corners"
        style={`${heroTilt} --stack-gap: var(--space-4); --vt-name: ${vtHead};`}
      >
        <p class="eyebrow">{site.name} · {site.role} at {site.employer}</p>
        <h1 class="hero-title">Designing the systems behind contract work.</h1>
        <p class="hero-lede">
          I'm a product designer at IntelAgree, where I work on the intake, review and approval
          steps that happen long before anyone signs anything. This is where I think in public
          about that work, and build things that have nothing to do with it.
        </p>
        <div class="cluster hero-actions">
          <a class="button" href="/contact/" style={markerStyle('hero:contact', 'var(--yellow)')}>
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div
        class="section-head-sheet sheet sheet--work pin pin--corners"
        style={`${workPin}; --vt-name: ${vtWork}; view-transition-class: vt vt-d1;`}
      >
        <div class="section-head">
          <h2 class="section-title prop">Selected work</h2>
          <a class="button" href="/work/" style={markerStyle('section:work:all', 'var(--route-work)')}>
            All case studies →
          </a>
        </div>
      </div>
      <div class="grid grid--2 scatter">
        {selected.map((entry) => <WorkCard entry={entry} />)}
      </div>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <div
            class="section-head-sheet sheet sheet--projects pin pin--corners"
            style={`${projectsPin}; --vt-name: ${vtProjects}; view-transition-class: vt vt-d2;`}
          >
            <div class="section-head">
              <h2 class="section-title prop">Projects</h2>
              <a class="button" href="/projects/" style={markerStyle('section:projects:all', 'var(--route-projects)')}>
                All projects →
              </a>
            </div>
          </div>
          <div class="grid grid--2 scatter">
            {projects.map((entry) => (
              <ProjectCard entry={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <div
            class="section-head-sheet sheet sheet--blog pin pin--corners"
            style={`${writingPin}; --vt-name: ${vtWriting}; view-transition-class: vt vt-d3;`}
          >
            <div class="section-head">
              <h2 class="section-title prop">Writing</h2>
              <a class="button" href="/blog/" style={markerStyle('section:writing:all', 'var(--route-blog)')}>
                All posts →
              </a>
            </div>
          </div>
          <div class="post-list scatter">
            {posts.map((entry) => (
              <PostCard entry={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-8) var(--space-8);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
  }

  .hero-sheet {
    padding: var(--sheet-pad);
  }

  .hero-title {
    font-size: var(--text-4xl);
    max-width: 20ch;
    margin: 0;
  }

  .hero-lede {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text);
    max-width: 56ch;
  }

  .hero-actions {
    margin-block-start: var(--space-6);
  }

  /* The home page's calls to action run a size up from the site's small boxes. */
  .hero-actions .button,
  .section-head .button {
    padding: 0.8em 1.5em;
    font-size: var(--text-base);
  }


  .section-title {
    font-size: var(--text-2xl);
    margin: 0;
    color: var(--text);
    /* No label padding: the title's type starts at the card's padding edge, level
       with the button's frame on the far side. */
    padding-inline: 0;
  }

  .grid {
    display: grid;
    gap: var(--space-7) var(--space-6);
  }

  .grid--2 {
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
  }

  .post-list {
    display: grid;
    gap: var(--space-5);
  }
</style>
