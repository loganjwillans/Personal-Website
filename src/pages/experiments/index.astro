---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExperimentCard from '@/components/ExperimentCard.astro';
import { getCollection } from 'astro:content';

const experiments = (await getCollection('experiments')).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<BaseLayout
  title="Experiments"
  description="Generative sketches made in Processing and p5.js — flow fields, noise, and other things with no stakeholder."
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Processing · p5.js</p>
      <h1 class="page-title">Experiments</h1>
      <p class="page-lede">
        Small programs I write to think. Most start in Processing, then get ported to p5.js so they
        can run here. None of them solve a problem, which is the point.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      {
        experiments.length === 0 ? (
          <p class="text-muted">No experiments yet.</p>
        ) : (
          <div class="grid">
            {experiments.map((entry) => (
              <ExperimentCard entry={entry} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-6);
    border-block-end: 2px solid var(--ink);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin-block-start: var(--space-3);
  }

  .page-lede {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-muted);
    max-width: 56ch;
    margin-block-start: var(--space-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-7) var(--space-6);
  }
</style>
