---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.tags.includes(tag))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`Posts tagged “${tag}”`} description={`Writing tagged ${tag}.`}>
  <section class="page-head">
    <div class="container container--narrow">
      <a class="back" href="/blog/">← All posts</a>
      <h1 class="page-title">Tagged “{tag}”</h1>
      <p class="page-lede">{posts.length} post{posts.length === 1 ? '' : 's'}.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--narrow">
      <div class="post-list">
        {posts.map((entry) => <PostCard entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-5);
    border-block-end: 2px solid var(--ink);
  }

  .back {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-underline-offset: 0.25em;
  }

  .page-title {
    font-size: var(--text-3xl);
    margin-block-start: var(--space-4);
  }

  .page-lede {
    color: var(--text-muted);
    margin-block-start: var(--space-2);
  }

  .post-list {
    display: grid;
    gap: var(--space-4);
  }
</style>
