---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { hashTilt, markerStyle, tiltStyle, viewName } from '@/lib/tilt';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.tags.includes(tag))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTilt = tiltStyle(hashTilt(`blog-tags-${tag}`));
const vtHead = viewName(Astro.url.pathname, 'head');
---

<BaseLayout title={`Posts tagged “${tag}”`} description={`Writing tagged ${tag}.`}>
  <section class="page-head">
    <div class="container">
      <div
        class="page-head-sheet sheet sheet--blog stack tilt pin pin--corners"
        style={`${pageTilt} --stack-gap: var(--space-4); --vt-name: ${vtHead};`}
      >
        <a class="button" href="/blog/" style={markerStyle(`tag:${tag}:all-posts`)}>
          ← All posts
        </a>
        <h1 class="page-title">Tagged “{tag}”</h1>
        <p class="page-lede">{posts.length} post{posts.length === 1 ? '' : 's'}.</p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--narrow">
      <div class="post-list scatter">
        {posts.map((entry) => <PostCard entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  /* The page-head's bottom padding plus this section's top padding would
     otherwise leave nearly twice the gap a blog post has before its content. */
  .page-head + .section {
    padding-block-start: var(--space-2);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin: 0;
  }

  /* Match the blog post hero: room under the back button, then the same gap
     from the headline to the summary. */
  .stack > .page-title {
    margin-block-start: var(--space-6);
  }

  .page-lede {
    color: var(--text);
    margin-block-start: var(--space-4);
  }

  .page-head-sheet {
    padding: var(--sheet-pad);
  }

  .post-list {
    display: grid;
    gap: var(--space-5);
  }
</style>
