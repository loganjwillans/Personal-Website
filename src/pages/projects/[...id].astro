---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import P5Canvas from '@/components/P5Canvas.astro';
import * as components from '@/components/content';
import { hashTilt, markerStyle, tiltStyle, viewName } from '@/lib/tilt';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data, id } = entry;
const headTilt = tiltStyle(hashTilt(id));
const vtHead = viewName(Astro.url.pathname, 'head');
const vtBody = viewName(Astro.url.pathname, 'body');
---

<BaseLayout title={data.title} description={data.description} type="article">
  <article class="Project">
    <header class="Project-head">
      <div class="container">
        <div
          class="Project-head-sheet sheet sheet--projects stack tilt pin pin--corners"
          style={`${headTilt} --stack-gap: var(--space-4); --vt-name: ${vtHead};`}
        >
          <a class="button" href="/projects/" style={markerStyle(`project:${id}:all`)}>
            ← All projects
          </a>
          <h1 class="Project-title">{data.title}</h1>
          <p class="Project-lede">{data.description}</p>
          <div class="Project-meta">
            <span>{data.kind}</span>
            <span aria-hidden="true">·</span>
            <span>{data.year}</span>
            {
              data.tags.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{data.tags.join(' / ')}</span>
                </>
              )
            }
          </div>
        </div>
      </div>
    </header>

    <div class="container container--narrow">
      <div class="prose" style={`--vt-name: ${vtBody};`}>
        {
          data.sketch && data.poster ? (
            <P5Canvas src={data.sketch} poster={data.poster} title={data.title} />
          ) : data.poster ? (
            <img class="Project-cover" src={data.poster} alt="" width="1200" height="750" />
          ) : null
        }

        <Content components={components} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .Project-head {
    /* The hero's bottom padding is the only gap before the write-up. The
       project hero tilts slightly differently from the blog hero, so this
       trims 8px to land the same visible gap as a blog post. */
    padding-block: var(--space-8) calc(var(--space-8) - 0.5rem);
  }

  .Project-title {
    font-size: var(--text-3xl);
    margin: 0;
    max-width: 24ch;
  }

  /* Match the blog post hero: room under the back button, then the same gap
     from the headline to the description. */
  .stack > .Project-title {
    margin-block-start: var(--space-6);
  }

  .Project-lede {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text);
    margin-block-start: var(--space-4);
    max-width: 54ch;
  }

  .Project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .Project-head-sheet {
    padding: var(--sheet-pad);
  }

  .Project-cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-block-end: var(--space-5);
  }
</style>
