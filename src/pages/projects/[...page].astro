---
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { hashTilt, markerStyle, pinStyle, tiltStyle, viewName } from '@/lib/tilt';

interface Props {
  page: Page<CollectionEntry<'projects'>>;
  tags: string[];
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
  );
  const tags = [...new Set(projects.flatMap((project) => project.data.tags))].sort();
  return paginate(projects, { pageSize: 6, props: { tags } });
}

const { page, tags } = Astro.props;
const projects = page.data;
const pageTilt = tiltStyle(hashTilt('projects-index'));
const filterTilt = tiltStyle(hashTilt('projects-filter'));
const vtHead = viewName(Astro.url.pathname, 'head');
const vtFilter = viewName(Astro.url.pathname, 'filter');
const vtPager = viewName(Astro.url.pathname, 'pager');
const pagerPins = pinStyle(hashTilt('projects-pager'));
---

<BaseLayout
  title="Projects"
  description="Code, research, papers and personal projects — things I make to work out an idea."
>
  <section class="page-head">
    <div class="container">
      <div
        class="page-head-sheet sheet sheet--projects stack tilt pin pin--corners"
        style={`${pageTilt}; --stack-gap: var(--space-4); --vt-name: ${vtHead};`}
      >
        <p class="eyebrow">Selected projects</p>
        <h1 class="page-title">Projects</h1>
        <p class="page-lede">
          Code, research, papers and personal projects — things I make to work out an idea. Some are
          interactive, some are just a write-up, and none of them need a stakeholder.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div
        class="section-head-sheet sheet pin pin--corners"
        style={`${filterTilt}; --vt-name: ${vtFilter}; view-transition-class: vt vt-d1;`}
      >
        <div class="search">
          <label class="visually-hidden" for="projects-search">Search projects</label>
          <input
            id="projects-search"
            class="search-input"
            type="search"
            placeholder="Search by title, summary or tag…"
            aria-label="Search projects"
            autocomplete="off"
            aria-describedby="projects-results"
          />
        </div>
        {
          tags.length > 0 && (
            <ul role="list" class="tag-list">
              {tags.map((tag) => (
                <li>
                  <button
                    type="button"
                    class="tag button tag-filter"
                    data-tag={tag}
                    aria-pressed="false"
                    style={markerStyle(`projects:tag:${tag}`)}
                  >
                    {tag}
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        projects.length === 0 ? (
          <p class="empty text-muted prop">No projects yet.</p>
        ) : (
          <div class="grid scatter" id="projects-grid">
            {projects.map((entry) => (
              <ProjectCard entry={entry} />
            ))}
          </div>
        )
      }

      <p class="empty text-muted prop" id="projects-empty" hidden>No projects match your search.</p>

      <div class="pager-card sheet pin pin--corners" style={`${pagerPins}; --vt-name: ${vtPager}; view-transition-class: vt vt-d4;`}>
        <p
          id="projects-results"
          class="result-count text-muted"
          role="status"
          aria-live="polite"
          data-total={page.total}
        >
          Showing {projects.length} of {page.total} projects.
        </p>
        {
          page.lastPage > 1 && (
            <nav class="pager" aria-label="Project pages">
              {page.url.prev ? (
                <a
                  class="button"
                  href={page.url.prev}
                  style={markerStyle(`projects:page:${page.currentPage}:prev`)}
                >
                  ← Previous
                </a>
              ) : (
                <span aria-hidden="true"></span>
              )}
              <span class="pager__status text-muted prop">Page {page.currentPage} of {page.lastPage}</span>
              {page.url.next ? (
                <a
                  class="button"
                  href={page.url.next}
                  style={markerStyle(`projects:page:${page.currentPage}:next`)}
                >
                  Next →
                </a>
              ) : (
                <span aria-hidden="true"></span>
              )}
            </nav>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function bindProjects() {
    const input = document.querySelector<HTMLInputElement>('#projects-search');
    const grid = document.querySelector<HTMLElement>('#projects-grid');
    const count = document.querySelector<HTMLElement>('#projects-results');
    const empty = document.querySelector<HTMLElement>('#projects-empty');
    if (!input || !grid || !count || !empty || input.dataset.bound) return;
    input.dataset.bound = 'true';

    const cards = [...grid.querySelectorAll<HTMLElement>('.Project')].map((card) => ({
      el: card,
      text: [
        card.querySelector('.Project__title')?.textContent,
        card.querySelector('.Project__summary')?.textContent,
        card.querySelector('.Project__meta')?.textContent,
        card.dataset.tags,
      ]
        .filter(Boolean)
        .join(' ')
        .toLowerCase(),
      tags: (card.dataset.tags || '').split('|').filter(Boolean),
    }));
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.tag-filter')];
    const total = Number(count.dataset.total);
    let activeTag = '';

    const apply = () => {
      const query = input.value.trim();
      const needle = query.toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const show =
          (!needle || card.text.includes(needle)) && (!activeTag || card.tags.includes(activeTag));
        card.el.hidden = !show;
        if (show) visible += 1;
      }
      const parts = [];
      if (query) parts.push(`“${query}”`);
      if (activeTag) parts.push(`tag ${activeTag}`);
      count.textContent = parts.length
        ? `${visible} of ${cards.length} projects on this page match ${parts.join(' + ')}`
        : `Showing ${cards.length} of ${total} projects.`;
      empty.hidden = visible !== 0;
      empty.textContent = `No projects match ${parts.join(' + ')}.`;
    };

    input.addEventListener('input', apply);
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const tag = button.dataset.tag || '';
        activeTag = activeTag === tag ? '' : tag;
        for (const other of buttons) {
          const pressed = other.dataset.tag === activeTag;
          other.setAttribute('aria-pressed', String(pressed));
          other.classList.toggle('is-active', pressed);
        }
        apply();
      });
    }
  }

  bindProjects();
  document.addEventListener('astro:page-load', bindProjects);
</script>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin: 0;
  }

  .page-lede {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text);
    max-width: 56ch;
  }

  .page-head-sheet {
    padding: var(--sheet-pad);
  }

  .search {
    display: grid;
  }

  .search-input {
    width: 100%;
    padding: 0.7em 1.15em;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-sharp);
    background: transparent;
    font-size: var(--text-sm);
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-filter {
    /* A bordered button like the rest of the site, but pill-shaped. */
    border-radius: var(--radius-full);
    background: transparent;
    padding: 0.5em 1em;
    font-size: var(--text-sm);
  }

  /* A selected filter keeps the highlighter stroke laid down. */
  .tag-filter[aria-pressed='true'] {
    color: var(--accent-contrast);
  }

  .tag-filter[aria-pressed='true']::before {
    opacity: 1;
    mask-position: 40% 0;
  }

  .result-count {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 600;
  }

  .pager-card {
    view-transition-name: var(--vt-name);
    display: grid;
    gap: var(--space-4);
    padding: var(--sheet-pad);
    margin-block-start: var(--space-6);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
  }

  .pager__status {
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-7) var(--space-6);
  }

  :global(.Project)[hidden] {
    display: none !important;
  }

  .empty {
    margin: 0;
  }

  @media (min-width: 42rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid > :global(:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
      justify-self: center;
      inline-size: calc(50% - var(--space-6) / 2);
    }
  }

  @media (max-width: 30rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .pager__status {
      grid-row: 1;
      grid-column: 1 / -1;
    }
  }
</style>
