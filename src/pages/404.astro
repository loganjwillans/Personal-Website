---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hashTilt, markerStyle, tiltStyle, viewName } from '@/lib/tilt';

const pageTilt = tiltStyle(hashTilt('404'));
const vtHead = viewName(Astro.url.pathname, 'head');
---

<BaseLayout title="Page not found" noindex>
  <section class="not-found">
    <div class="container">
      <div
        class="not-found-sheet sheet sheet--red stack tilt pin pin--corners"
        style={`${pageTilt} --stack-gap: var(--space-4); --vt-name: ${vtHead};`}
      >
        <p class="eyebrow">404</p>
        <img
          class="not-found__motif"
          src="/logo.svg"
          alt=""
          width="185"
          height="90"
          draggable="false"
        />
        <h1 class="title">This page doesn't exist.</h1>
        <p class="lede">
          Either it moved, or a link is wrong. The work and the writing are still where you left them.
        </p>
        <div class="actions">
          <a class="button button--primary" href="/" style={markerStyle('404:home')}>Home</a>
          <a class="button" href="/work/" style={markerStyle('404:work')}>Work</a>
          <a class="button" href="/blog/" style={markerStyle('404:blog')}>Blog</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-10);
  }

  .not-found__motif {
    display: block;
    width: 9rem;
    height: auto;
    margin: 0;
  }

  .not-found-sheet {
    padding: var(--sheet-pad);
  }

  .title {
    font-size: var(--text-3xl);
    margin: 0;
  }

  .lede {
    color: var(--text-muted);
    max-width: 48ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
  }
</style>
