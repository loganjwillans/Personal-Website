---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config';
import { hashTilt, markerStyle, pinStyle, tiltStyle, viewName } from '@/lib/tilt';

const pageTilt = tiltStyle(hashTilt('about'));
const bodyPin = pinStyle(hashTilt('about-body'));
const vtHead = viewName(Astro.url.pathname, 'head');
const vtBody = viewName(Astro.url.pathname, 'body');
---

<BaseLayout
  title="About"
  description="Logan Willans is a product designer at IntelAgree, working on contract management software."
>
  <section class="page-head">
    <div class="container">
      <div
        class="page-head-sheet sheet sheet--about stack tilt pin pin--corners"
        style={`${pageTilt} --stack-gap: var(--space-4); --vt-name: ${vtHead};`}
      >
        <p class="eyebrow">About</p>
        <h1 class="page-title">Logan Willans</h1>
        <p class="page-lede">
          Product designer at IntelAgree. I work on contract management software â€” the intake,
          review, negotiation and approval steps that sit between "we need a contract" and a
          signature.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--narrow">
      <div class="prose sheet pin pin--corners" style={`${bodyPin}; --vt-name: ${vtBody};`}>
        <h2>What I actually do</h2>
        <p>
          Most of my work is enterprise software, which means the interesting constraints are never
          on a moodboard. Legal teams are measured on risk and cycle time; sales teams are measured
          on speed. Both use the same tool, and neither has time to learn it. Designing there means
          spending more time on permissions, states and exceptions than on colour.
        </p>
        <p>
          <!-- TODO: replace with the specific products or surfaces you own at IntelAgree. -->
          At IntelAgree I own design for the contract workspace: the place where a redlined
          document, a clause library and a review checklist all have to agree with each other.
        </p>

        <h2>How I work</h2>
        <ul>
          <li>
            <strong>Start with the artefact.</strong> A real contract, a real review, a real support
            ticket. Abstract personas are a last resort.
          </li>
          <li>
            <strong>Prototype to disagree.</strong> A clickable prototype settles an argument faster
            than a slide, and it makes the edge cases visible early.
          </li>
          <li>
            <strong>Design the system, not the screen.</strong> Components, states and content rules
            outlive any single feature.
          </li>
          <li>
            <strong>Write it down.</strong> Decisions with their trade-offs, in the repo, where
            engineers can find them.
          </li>
        </ul>

        <h2>Off the clock</h2>
        <p>
          I write small generative programs in Processing and port them to p5.js â€” the
          <a href="/projects/">projects</a> section is where those live. It keeps my hands in
          code, and it is a reliable way to make something that doesn't need a stakeholder review.
        </p>

        <h2>Get in touch</h2>
        <p>
          Email is best: <a href={`mailto:${site.email}`}>{site.email}</a>. I'm also on
          <a href={site.profiles[0]?.href} rel="me noopener">LinkedIn</a>.
        </p>
        <!-- TODO: add previous roles, education, or a downloadable CV if you want them public. -->
      </div>

      <div class="about-actions">
        <a
          class="button button--primary"
          href={`mailto:${site.email}`}
          style={markerStyle('about:email')}
        >
          Email me
        </a>
        <a class="button" href="/work/" style={markerStyle('about:work')}>See the work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin: 0;
  }

  .page-lede {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text);
    max-width: 56ch;
  }

  .page-head-sheet {
    padding: var(--sheet-pad);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-7);
  }

  .prose.sheet {
    padding: var(--sheet-pad);
  }
</style>
