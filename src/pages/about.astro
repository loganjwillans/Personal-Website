---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import * as components from '@/components/content';
import { hashTilt, tiltStyle, viewName } from '@/lib/tilt';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing about page in src/content/pages/about.mdx');
const { Content } = await render(entry);
const { data } = entry;

const pageTilt = tiltStyle(hashTilt('about'));
const vtHead = viewName(Astro.url.pathname, 'head');
const vtBody = viewName(Astro.url.pathname, 'body');
---

<BaseLayout title="About" description={data.description}>
  <section class="page-head">
    <div class="container">
      <div
        class="page-head-sheet sheet sheet--about stack tilt pin pin--corners"
        style={`${pageTilt}; --stack-gap: var(--space-4); --vt-name: ${vtHead};`}
      >
        <p class="eyebrow">{data.eyebrow}</p>
        <h1 class="page-title">{data.title}</h1>
        <p class="page-lede">{data.description}</p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--narrow">
      <div class="prose" style={`--vt-name: ${vtBody};`}>
        <Content components={components} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  .page-title {
    font-size: var(--text-3xl);
    margin: 0;
  }

  .page-lede {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text);
    max-width: 56ch;
  }

  .page-head-sheet {
    padding: var(--sheet-pad);
  }
</style>
