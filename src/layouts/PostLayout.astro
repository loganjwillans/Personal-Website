---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingLabel } from '@/lib/format';
import { hashTilt, markerStyle, tiltStyle, viewName } from '@/lib/tilt';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data, body, id } = entry;
const headTilt = tiltStyle(hashTilt(id));
// Page-scoped names: nothing here can pair with another page's copy.
const vtHead = viewName(Astro.url.pathname, 'head');
const vtBody = viewName(Astro.url.pathname, 'body');
---

<article class="post">
  <header class="post-head">
    <div class="container">
      <div
        class="post-head-sheet sheet sheet--blog stack tilt pin pin--corners"
        style={`${headTilt} --stack-gap: var(--space-4); --vt-name: ${vtHead};`}
      >
        <a class="button" href="/blog/" style={markerStyle(`post:${id}:all-posts`)}>
          ← All posts
        </a>
        <h1 class="post-title">{data.title}</h1>
        <p class="post-description">{data.description}</p>
        <div class="post-meta">
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingLabel(body ?? '')}</span>
          {
            data.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {formatDate(data.updatedDate)}</span>
              </>
            )
          }
        </div>
        {
          data.tags.length > 0 && (
            <ul role="list" class="post-tags">
              {data.tags.map((tag) => (
                <li>
                  <a class="tag prop" href={`/blog/tags/${tag}/`}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </header>

  <div class="container container--narrow">
    <div class="prose" style={`--vt-name: ${vtBody};`}>
      <slot />
    </div>
  </div>
</article>

<style>
  .post-head {
    /* The hero's bottom padding is the only gap before the article: both detail
       pages start their body one section-space below the sheet. */
    padding-block: var(--space-8);
  }

  .post-title {
    font-size: var(--text-3xl);
    margin: 0;
    max-width: 24ch;
  }

  /* Give the "All posts" button room above the headline. */
  .stack > .post-title {
    margin-block-start: var(--space-6);
  }

  .post-description {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text);
    max-width: 54ch;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack > .post-tags {
    margin-block-start: var(--space-5);
  }

  /* Pill labels like the blog filters, but plain links: no marker scribble. */
  .post-tags .tag {
    padding: 0.5em 1em;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: transparent;
  }

  .post-head-sheet {
    padding: var(--sheet-pad);
  }
</style>
