---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingLabel } from '@/lib/format';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data, body } = entry;
---

<article class="post">
  <header class="post-head">
    <div class="container container--narrow">
      <a class="post-back" href="/blog/">← All posts</a>
      <h1 class="post-title">{data.title}</h1>
      <p class="post-description">{data.description}</p>
      <div class="post-meta">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingLabel(body ?? '')}</span>
        {
          data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formatDate(data.updatedDate)}</span>
            </>
          )
        }
      </div>
      {
        data.tags.length > 0 && (
          <ul role="list" class="post-tags">
            {data.tags.map((tag) => (
              <li>
                <a class="tag" href={`/blog/tags/${tag}/`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </header>

  <div class="container container--narrow">
    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <p>
        Written by Logan Willans. Replies and corrections are welcome at
        <a href="mailto:design@brainvat.xyz">design@brainvat.xyz</a>.
      </p>
      <a class="button" href="/blog/">Read more posts</a>
    </footer>
  </div>
</article>

<style>
  .post-head {
    padding-block: var(--space-8) var(--space-6);
    border-block-end: 1px solid var(--border);
  }

  .post-back {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
  }

  .post-back:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .post-title {
    font-size: var(--text-3xl);
    margin-block-start: var(--space-5);
    max-width: 24ch;
  }

  .post-description {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-muted);
    margin-block-start: var(--space-3);
    max-width: 54ch;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .post-tags .tag:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .post > .container--narrow {
    padding-block-start: var(--space-6);
  }

  .post-footer {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .post-footer p {
    max-width: 56ch;
  }

  .post-footer .button {
    justify-self: start;
  }
</style>
