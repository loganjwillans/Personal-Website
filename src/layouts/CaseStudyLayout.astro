---
import type { CollectionEntry } from 'astro:content';
import ProtectedContent from '@/components/ProtectedContent.astro';
import LockIcon from '@/components/LockIcon.astro';
import { envNameForId } from '@/lib/slug';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { data, id } = entry;

const facts = [
  { label: 'Role', value: data.role },
  { label: 'Timeline', value: data.duration },
  { label: 'Team', value: data.team },
  { label: 'Year', value: String(data.year) },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));
---

<article class="case-study">
  <header class="cs-header">
    <div class="container container--narrow">
      <div class="cs-eyebrow">
        <span class="eyebrow">{data.client ? `${data.client} · Case study` : 'Case study'}</span>
        {
          data.protected && (
            <span class="lock-badge">
              <LockIcon size={11} />
              Password protected
            </span>
          )
        }
      </div>

      <h1 class="cs-title">{data.title}</h1>
      <p class="cs-summary">{data.summary}</p>

      <dl class="cs-facts">
        {
          facts.map((fact) => (
            <div class="cs-fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        data.tags.length > 0 && (
          <ul role="list" class="cs-tags">
            {data.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </header>

  {
    data.cover && (
      <figure class="cs-cover">
        <img
          src={data.cover}
          alt={data.coverAlt}
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
        />
      </figure>
    )
  }

  <div class="container container--narrow">
    {
      data.placeholder && (
        <aside class="cs-placeholder">
          <p>
            <strong>Sample content.</strong> This case study ships as a structural demo. Replace
            the copy with real work (or delete the file) before sharing the site.
          </p>
        </aside>
      )
    }

    {
      data.protected ? (
        <ProtectedContent slug={id} passwordEnv={data.passwordEnv ?? envNameForId(id)}>
          <slot />
        </ProtectedContent>
      ) : (
        <div class="prose">
          <slot />
        </div>
      )
    }

    <nav class="cs-footer" aria-label="Case study">
      <a class="button" href="/work/">← All work</a>
    </nav>
  </div>
</article>

<style>
  .cs-header {
    padding-block: var(--space-8) var(--space-6);
  }

  .cs-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .cs-title {
    font-size: var(--text-4xl);
    margin-block-start: var(--space-3);
    max-width: 20ch;
  }

  .cs-summary {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-muted);
    margin-block-start: var(--space-4);
    max-width: 52ch;
  }

  .cs-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-6) 0;
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border);
  }

  .cs-fact dt {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
  }

  .cs-fact dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .cs-cover {
    margin: 0 auto var(--space-6);
    max-width: var(--wide);
    padding-inline: var(--gutter);
  }

  .cs-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-2);
  }

  .cs-placeholder {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-block-end: var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-muted);
    background: var(--surface-2);
  }

  .cs-footer {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border);
  }
</style>
