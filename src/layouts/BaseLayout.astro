---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { absoluteUrl, site } from '@/config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description = site.description,
  noindex = false,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = absoluteUrl(image);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#C9A06B" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2A211B" media="(prefers-color-scheme: dark)" />

    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Permanent+Marker&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme =
            stored === 'light' || stored === 'dark' ? stored : system;
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <script is:inline>
      // The client router rebuilds <html> from the fetched document, so carry the
      // theme, the script flag and the cork's scroll phase over before the swap
      // instead of after it.
      document.addEventListener('astro:before-swap', (event) => {
        const root = document.documentElement;
        const incoming = event.newDocument.documentElement;
        incoming.dataset.theme = root.dataset.theme;
        incoming.className = root.className;
        // The cork is pinned to the document, so a new page opening at the top
        // must show the grain the old page had at its own scroll: shift the
        // background up by exactly that scroll. Going back restores the scroll
        // the entry was left on, so it takes the phase it was left with.
        const offset = parseFloat(getComputedStyle(root).getPropertyValue('--bg-offset')) || 0;
        const carried =
          event.navigationType === 'traverse'
            ? parseFloat(history.state && history.state.bgOffset) || 0
            : offset - window.scrollY;
        incoming.style.setProperty('--bg-offset', `${carried}px`);
        if (event.navigationType !== 'traverse') {
          // Keep this entry's phase, so the next visit back finds the same board.
          history.replaceState({ ...history.state, bgOffset: offset }, '');
        }
      });

      // Client-side navigation keeps the document: put focus back at the top of
      // the new page, where a full page load would have left it.
      document.addEventListener('astro:after-swap', () => {
        if (location.hash) return;
        document.getElementById('main')?.focus({ preventScroll: true });
      });
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
