---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { site } from '@/config';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isCurrent(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" focusable="false">
          <circle cx="16" cy="16" r="14" fill="var(--accent)"></circle>
          <path
            d="M16 25c-5 0-9-4-9-9s4-9 9-9 9 4 9 9-4 9-9 9"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"></path>
          <path
            d="M16 21c-2.8 0-5-2.2-5-5s2.2-5 5-5 5 2.2 5 5-2.2 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"></path>
          <circle cx="16" cy="16" r="2.5" fill="currentColor"></circle>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__role">{site.role}</span>
      </span>
    </a>

    <div class="header-nav">
      <nav aria-label="Primary">
        <ul role="list" class="nav">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={['nav__link', { 'nav__link--current': isCurrent(item.href) }]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 2px solid var(--ink);
    /* srgb, not oklch: mixing with transparent in oklch drops the hue and tints the band pink. */
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand__mark {
    width: 2rem;
    height: 2rem;
    flex: none;
    color: var(--ink);
    filter: drop-shadow(2px 2px 0 var(--shadow-ink));
    transition: transform var(--duration-1) var(--ease);
  }

  .brand:hover .brand__mark,
  .brand:focus-visible .brand__mark {
    transform: rotate(12deg) scale(1.05);
  }

  .brand__mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    font-size: var(--text-base);
  }

  .brand__role {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-flex;
    padding: 0.45em 0.85em;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--text-muted);
    border: 2px solid transparent;
    background: transparent;
    transition:
      transform var(--duration-1) var(--ease),
      box-shadow var(--duration-1) var(--ease),
      color var(--duration-1) var(--ease),
      background-color var(--duration-1) var(--ease),
      border-color var(--duration-1) var(--ease);
  }

  .nav__link:hover {
    color: var(--text);
    background: var(--surface);
    border-color: var(--ink);
    box-shadow: var(--shadow-key-sm);
    transform: translate(-1px, -1px);
  }

  .nav__link--current {
    color: var(--text);
    background: var(--surface);
    border-color: var(--ink);
    box-shadow: var(--shadow-key-sm);
  }

  @media (max-width: 40rem) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
    }

    .header-nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
