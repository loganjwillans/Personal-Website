---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/format';
import { hashTilt, tiltStyle, viewName } from '@/lib/tilt';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data, id } = entry;
const preview = data.preview;
const title = preview?.title ?? data.title;
const summary = preview?.summary ?? data.description;
const showMeta = preview?.showMeta ?? true;
const showTags = preview?.showTags ?? true;
const tilt = tiltStyle(hashTilt(id));
const vtName = viewName(Astro.url.pathname, `post-${id}`);
---

<article
  class="post-row object pin pin--corners lift"
  style={`${tilt}; --vt-name: ${vtName};`}
  data-tags={data.tags.join('|')}
>
  <h3 class="post-row__title">
    <a href={`/blog/${id}/`}>{title}</a>
  </h3>
  <p class="post-row__summary">{summary}</p>
  {
    showMeta && (
      <div class="post-row__meta">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        {
          showTags && data.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{data.tags.join(', ')}</span>
            </>
          )
        }
      </div>
    )
  }
</article>

<style>
  .post-row {
    position: relative;
    display: grid;
    gap: var(--space-3);
    /* The top margin is the pin's; the other sides match the sheet cards that
       surround the list, so the printed content lines up across the page. */
    padding: var(--pin-clearance) var(--sheet-pad) var(--sheet-pad);
  }

  .post-row__title {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .post-row__title a {
    text-decoration: none;
  }

  /* One link per row: the title's hit area covers the whole card. */
  .post-row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-row__title a:focus-visible {
    outline: none;
  }

  .post-row__title a:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: 6px;
    border-radius: var(--radius-sharp);
  }

  .post-row__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-underline-offset: 0.22em;
  }

  .post-row__summary {
    color: var(--text);
    font-size: var(--text-base);
    max-width: 58ch;
    margin: 0;
  }

  .post-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>
