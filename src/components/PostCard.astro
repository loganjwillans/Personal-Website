---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/format';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data, id } = entry;
---

<article class="post-row">
  <h3 class="post-row__title">
    <a href={`/blog/${id}/`}>{data.title}</a>
  </h3>
  <p class="post-row__summary">{data.description}</p>
  <div class="post-row__meta">
    <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
    {
      data.tags.length > 0 && (
        <>
          <span aria-hidden="true">·</span>
          <span>{data.tags.join(', ')}</span>
        </>
      )
    }
  </div>
</article>

<style>
  .post-row {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--surface);
    background-image: var(--speckle);
    background-size: var(--speckle-size);
    box-shadow: var(--shadow-key-sm);
    transition:
      transform var(--duration-2) var(--ease),
      box-shadow var(--duration-2) var(--ease);
  }

  .post-row:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-key);
  }

  .post-row__title {
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .post-row__title a {
    text-decoration: none;
  }

  .post-row__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-underline-offset: 0.22em;
  }

  .post-row__summary {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: 58ch;
    margin: 0;
  }

  .post-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
</style>
