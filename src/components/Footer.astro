---
import { site } from '@/config';
import { hashTilt, pinStyle, viewName } from '@/lib/tilt';

const year = new Date().getFullYear();
const footerPin = pinStyle(hashTilt('footer'));
const vtName = viewName(Astro.url.pathname, 'footer');
---

<footer class="site-footer sheet pin pin--corners" style={`${footerPin}; --vt-name: ${vtName};`}>
  <div class="container footer-inner">
    <div class="footer-col">
      <p class="footer-name">{site.name}</p>
      <p class="footer-meta">{site.role} at {site.employer}</p>
    </div>

    <div class="footer-col">
      <p class="footer-eyebrow prop">Elsewhere</p>
      <ul role="list" class="footer-links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {
          site.profiles.map((profile) => (
            <li>
              <a href={profile.href} rel="me noopener">
                {profile.label}
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-eyebrow prop">Site</p>
      <ul role="list" class="footer-links">
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        {/* Contact lives in the footer only: it is not one of site.nav's routes. */}
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.name}. Built with Astro.</p>
    <p class="footer-note">Set in Space Grotesk and Outfit.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    /* As wide as the sheets in the content column: the container width less its
       gutters, so cork shows on both sides and the footer lines up edge to edge
       with the sheets above it. */
    width: calc(min(100%, var(--wide)) - var(--gutter) * 2);
    margin-inline: auto;
    margin-block-start: var(--space-9);
  }

  /* The sheet padding is the footer's only inset: the container gutter would
     double it now that the sheet is no longer full-bleed. */
  .site-footer .container {
    padding-inline: 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .footer-eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 650;
    color: var(--ink);
    background: var(--blush);
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    font-size: var(--text-lg);
  }

  .footer-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-block-start: var(--space-1);
  }

  .footer-links {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--ink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .footer-note {
    max-width: 34ch;
  }
</style>
