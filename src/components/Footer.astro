---
import { site } from '@/config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <svg class="footer-motif" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <g fill="currentColor">
      <path d="M24 24c0-6 4.5-10.5 10.5-10.5S45 18 45 24s-4.5 10.5-10.5 10.5S24 30 24 24"></path>
      <path d="M24 24c-6 0-10.5-4.5-10.5-10.5S18 3 24 3s10.5 4.5 10.5 10.5S30 24 24 24"></path>
      <path d="M24 24c0 6-4.5 10.5-10.5 10.5S3 30 3 24s4.5-10.5 10.5-10.5S24 18 24 24"></path>
      <path d="M24 24c6 0 10.5 4.5 10.5 10.5S30 45 24 45s-10.5-4.5-10.5-10.5S18 24 24 24"></path>
    </g>
    <circle cx="24" cy="24" r="7" fill="var(--ink)"></circle>
  </svg>
  <div class="container footer-inner">
    <div class="footer-col">
      <p class="footer-name">{site.name}</p>
      <p class="footer-meta">{site.role} at {site.employer}</p>
    </div>

    <div class="footer-col">
      <p class="eyebrow">Elsewhere</p>
      <ul role="list" class="footer-links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {
          site.profiles.map((profile) => (
            <li>
              <a href={profile.href} rel="me noopener">
                {profile.label}
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="eyebrow">Site</p>
      <ul role="list" class="footer-links">
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.name}. Built with Astro.</p>
    <p class="footer-note">Set in Jost, with a system sans for body copy.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-block-start: 2px solid var(--ink);
    margin-block-start: var(--space-9);
    padding-block: var(--space-7) var(--space-5);
    background: var(--surface);
    background-image: var(--speckle);
    background-size: var(--speckle-size);
  }

  .footer-motif {
    position: absolute;
    top: calc(var(--space-5) * -1);
    right: var(--gutter);
    width: 3.25rem;
    height: 3.25rem;
    color: var(--accent-3);
    filter: drop-shadow(2px 2px 0 var(--shadow-ink));
    pointer-events: none;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-6);
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
  }

  .footer-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .footer-links {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--ink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-4);
    border-block-start: 2px solid var(--ink);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .footer-note {
    max-width: 34ch;
  }
</style>
