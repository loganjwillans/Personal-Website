---
import { site } from '@/config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <p class="footer-name">{site.name}</p>
      <p class="footer-meta">{site.role} at {site.employer}</p>
    </div>

    <div class="footer-col">
      <p class="eyebrow">Elsewhere</p>
      <ul role="list" class="footer-links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {
          site.profiles.map((profile) => (
            <li>
              <a href={profile.href} rel="me noopener">
                {profile.label}
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="eyebrow">Site</p>
      <ul role="list" class="footer-links">
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.name}. Built with Astro.</p>
    <p class="footer-note">Set in a system sans while the brand type is decided.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--border);
    margin-block-start: var(--space-9);
    padding-block: var(--space-7) var(--space-5);
    background: var(--surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-6);
  }

  .footer-name {
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
  }

  .footer-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .footer-links {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .footer-note {
    max-width: 34ch;
  }
</style>
