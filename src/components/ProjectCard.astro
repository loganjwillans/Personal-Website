---
import type { CollectionEntry } from 'astro:content';
import { hashTilt, tiltStyle, viewName } from '@/lib/tilt';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { data, id } = entry;
const preview = data.preview;
const image = preview?.image ?? data.poster;
const title = preview?.title ?? data.title;
const summary = preview?.summary ?? data.description;
const showImage = preview?.showImage ?? true;
const showMeta = preview?.showMeta ?? true;
const showTags = preview?.showTags ?? true;
const tilt = tiltStyle(hashTilt(id));
const vtName = viewName(Astro.url.pathname, `Project-${id}`);
---

<article class="Project" data-tags={data.tags.join('|')}>
  <a
    class="Project__link object pin lift"
    href={`/projects/${id}/`}
    style={`${tilt}; --vt-name: ${vtName};`}
  >
    {
      showImage ? (
        image ? (
          <img
            class="Project__poster"
            src={image}
            alt=""
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="Project__poster Project__poster--empty" aria-hidden="true" />
        )
      ) : null
    }
    <div class="Project__body">
      {
        showMeta && (
          <div class="Project__meta">
            <span>{data.kind}</span>
            <span aria-hidden="true">·</span>
            <span>{data.year}</span>
            {
              showTags && data.tags.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{data.tags.join(' / ')}</span>
                </>
              )
            }
          </div>
        )
      }
      <h3 class="Project__title">{title}</h3>
      <p class="Project__summary">{summary}</p>
    </div>
  </a>
</article>

<style>
  .Project__link {
    display: grid;
    gap: var(--space-5);
    text-decoration: none;
    /* The top margin is the pin's: the head sits in it, clear of the poster. */
    padding: var(--pin-clearance) var(--space-5) var(--space-5);
  }

  .Project__poster {
    /* Printed straight on the card's paper: no frame, and no movement of its
       own — only the card lifts. */
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .Project__poster--empty {
    /* Projects without a cover still get the same printed block of paper. */
    background: var(--surface-2);
  }

  .Project__body {
    display: grid;
    gap: var(--space-3);
  }

  .Project__meta {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .Project__title {
    font-size: var(--text-base);
    margin: 0;
    letter-spacing: var(--tracking-tight);
  }

  .Project__link:hover .Project__title {
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-underline-offset: 0.22em;
  }

  .Project__summary {
    font-size: var(--text-sm);
    color: var(--text);
    margin: 0;
  }
</style>
