---
import { pinStyleFor, viewName } from '@/lib/tilt';

interface Props {
  /** Heading printed at the top of the card. */
  title?: string;
  /** Small uppercase line above the heading. */
  label?: string;
  /** Background colour printed on the pinned card. */
  color?: 'paper' | 'cream' | 'blush' | 'green' | 'blue' | 'yellow';
  /** Corner pins: a pair picked each render, or a fixed fastener kind. */
  pins?: 'tack' | 'pushpin' | 'random';
  /** Stable id for the transition name when two cards share a title. */
  name?: string;
}

const { title, label, color = 'paper', pins = 'random', name } = Astro.props;
const slug =
  (name ?? title ?? 'card')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'card';
const vtName = viewName(Astro.url.pathname, `card-${slug}`);
const hash = [...slug].reduce((h, char) => (Math.imul(h, 31) + char.charCodeAt(0)) >>> 0, 7);
const bucket = (hash % 4) + 1;
const style = [
  pinStyleFor(pins),
  `--vt-name: ${vtName}`,
  `view-transition-class: vt vt-d${bucket}`,
].join('; ');
---

<section
  class:list={['entry-card', `entry-card--${color}`, 'pin', 'pin--corners']}
  style={style}
>
  {
    (label || title) && (
      <header class="entry-card__head">
        {label && <p class="entry-card__label">{label}</p>}
        {title && <h2 class="entry-card__title">{title}</h2>}
      </header>
    )
  }
  <div class="entry-card__body"><slot /></div>
</section>

<style>
  .entry-card {
    view-transition-name: var(--vt-name);
    view-transition-class: vt;
    /* A separate white sheet, set apart from the surrounding card by a gap. */
    background-color: var(--sheet);
    background-image: var(--paper-texture);
    background-size: var(--paper-texture-size);
    background-blend-mode: var(--paper-texture-blend);
    border-radius: var(--panel-radius);
    box-shadow: var(--panel-shadow);
    padding: var(--sheet-pad);
    margin-block: var(--space-7);
    color: var(--text);
  }

  /* A wash of colour over the sheet, not a full-colour block. */
  .entry-card--cream { background-color: color-mix(in srgb, var(--cream) 35%, var(--sheet)); }
  .entry-card--blush { background-color: color-mix(in srgb, var(--blush) 35%, var(--sheet)); }
  .entry-card--green { background-color: color-mix(in srgb, var(--green) 18%, var(--sheet)); }
  .entry-card--blue { background-color: color-mix(in srgb, var(--blue) 18%, var(--sheet)); }
  .entry-card--yellow { background-color: color-mix(in srgb, var(--yellow) 22%, var(--sheet)); }

  .entry-card__head {
    display: grid;
    gap: var(--space-2);
    margin-block-end: var(--space-5);
  }

  .entry-card__label {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .entry-card__title {
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .entry-card__body > :first-child {
    margin-block-start: 0;
  }

  .entry-card__body > :last-child {
    margin-block-end: 0;
  }
</style>
