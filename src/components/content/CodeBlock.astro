---
import { Code } from 'astro:components';

interface Props {
  /** The code to display, as a plain string. */
  code: string;
  /** Shiki language id, e.g. `js`, `ts`, `css`. */
  language?: string;
  /** Small printed label above the block, e.g. a filename. */
  title?: string;
}

const { code, language = 'text', title } = Astro.props;
---

<figure class="code-block">
  {title && <figcaption class="code-block__title">{title}</figcaption>}
  <div class="code-block__surface">
    <Code code={code} lang={language as 'js'} theme="github-dark" wrap />
  </div>
</figure>

<style>
  .code-block {
    /* Printed on the sheet, so it travels with that sheet's transition. */
    margin-block: var(--space-6);
  }

  .code-block__title {
    margin-block-end: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .code-block__surface {
    position: relative;
    overflow-x: auto;
    background: var(--charcoal);
    border-radius: var(--radius-sharp);
    padding: var(--space-4);
  }

  .code-block__surface::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--paper-texture);
    background-size: var(--paper-texture-size);
    mix-blend-mode: soft-light;
    opacity: 0.18;
    pointer-events: none;
  }

  .code-block__surface :global(pre) {
    position: relative;
    z-index: 1;
  }

  .code-block__surface :global(pre) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--offwhite);
  }

  .code-block__surface :global(code) {
    font-family: var(--font-mono);
    background: none;
    padding: 0;
    color: inherit;
  }
</style>
