---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experiments'>;
}

const { entry } = Astro.props;
const { data, id } = entry;
---

<article class="experiment">
  <a class="experiment__link" href={`/experiments/${id}/`}>
    <img
      class="experiment__poster"
      src={data.poster}
      alt=""
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    <div class="experiment__body">
      <div class="experiment__meta">
        <span>{data.year}</span>
        <span aria-hidden="true">·</span>
        <span>{data.tags.join(' / ')}</span>
      </div>
      <h3 class="experiment__title">{data.title}</h3>
      <p class="experiment__summary">{data.description}</p>
    </div>
  </a>
</article>

<style>
  .experiment__link {
    display: grid;
    gap: var(--space-4);
    text-decoration: none;
    background: var(--surface);
    background-image: var(--speckle);
    background-size: var(--speckle-size);
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow-key);
    transition:
      transform var(--duration-2) var(--ease),
      box-shadow var(--duration-2) var(--ease);
  }

  .experiment__link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--shadow-ink);
  }

  .experiment__link:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--shadow-ink);
  }

  .experiment__poster {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 2px solid var(--ink);
    background: var(--surface-2);
    transition: transform var(--duration-2) var(--ease);
  }

  .experiment__link:hover .experiment__poster {
    transform: scale(1.012);
  }

  .experiment__body {
    display: grid;
    gap: var(--space-1);
  }

  .experiment__meta {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .experiment__title {
    font-size: var(--text-base);
    margin: 0;
    letter-spacing: var(--tracking-tight);
  }

  .experiment__link:hover .experiment__title {
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-underline-offset: 0.22em;
  }

  .experiment__summary {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }
</style>
