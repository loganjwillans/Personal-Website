---
interface Props {
  size?: number;
}
const { size = 12 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  aria-hidden="true"
  focusable="false"
  class="lock-icon"
>
  <rect
    x="3.4"
    y="7"
    width="9.2"
    height="7"
    rx="1.6"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"></rect>
  <path
    d="M5.6 7V5.2a2.4 2.4 0 0 1 4.8 0V7"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"></path>
</svg>
