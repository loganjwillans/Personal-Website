---
import type { CollectionEntry } from 'astro:content';
import LockIcon from '@/components/LockIcon.astro';
import { hashTilt, tiltStyle, viewName } from '@/lib/tilt';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Compact cards drop the summary — used in tighter grids. */
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const { data, id } = entry;
const preview = data.preview;
const image = preview?.image ?? data.cover;
const title = preview?.title ?? data.title;
const summary = preview?.summary ?? data.summary;
const showImage = preview?.showImage ?? true;
const showMeta = preview?.showMeta ?? true;
const showTags = preview?.showTags ?? true;
const showBadge = preview?.showBadge ?? true;
const tilt = tiltStyle(hashTilt(id));
// Page-scoped: home and /work/ never share a name, so the card peels on one
// page and is pinned on the other instead of morphing between them.
const vtName = viewName(Astro.url.pathname, `work-${id}`);
---

<article
  class:list={['card object pin lift', { 'card--compact': compact }]}
  style={`${tilt}; --vt-name: ${vtName};`}
>
  {
    showImage ? (
      image ? (
        <img
          class="card__media"
          src={image}
          alt=""
          width="1200"
          height="750"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="card__media card__media--empty" aria-hidden="true" />
      )
    ) : null
  }

  <div class="card__body">
    {
      showMeta && (
        <div class="card__meta">
          <span>{data.year}</span>
          {data.client ? <span aria-hidden="true">·</span> : null}
          {data.client ? <span>{data.client}</span> : null}
        </div>
      )
    }
    {showBadge && data.protected ? (
      <span class="lock-badge prop"><LockIcon size={11} /> Protected</span>
    ) : null}

    <h3 class="card__title">
      <a href={`/work/${id}/`}>{title}</a>
    </h3>

    {!compact && <p class="card__summary">{summary}</p>}

    {
      showTags && data.tags.length > 0 && (
        <ul role="list" class="card__tags">
          {data.tags.map((tag) => (
            <li class="tag prop">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    position: relative;
    /* The top margin is the pin's: the head sits in it, clear of the print. */
    padding: var(--pin-clearance) var(--space-5) var(--space-5);
  }

  .card__media {
    /* Printed straight on the card's paper: no frame, and no movement of its
       own — only the card lifts. */
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .card__media--empty {
    background: linear-gradient(135deg, var(--surface-2) 50%, var(--bg) 50%);
  }

  .card__body {
    display: grid;
    gap: var(--space-3);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }



  .card__title {
    font-size: var(--text-lg);
    margin: 0;
    letter-spacing: var(--tracking-tight);
  }

  .card__title a {
    text-decoration: none;
  }

  /* One link per card: the title's hit area covers the whole card. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card__title a:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: 6px;
    border-radius: var(--radius-sharp);
  }

  .card__summary {
    font-size: var(--text-sm);
    color: var(--text);
    margin: 0;
    max-width: 48ch;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    padding: 0;
    list-style: none;
  }



  .card--compact {
    gap: var(--space-3);
    padding: var(--pin-clearance) var(--space-3) var(--space-3);
  }
</style>
