---
interface Props {
  title: string;
  tradeoff: string;
}

const { title, tradeoff } = Astro.props;
---

<aside class="decision">
  <p class="decision__eyebrow prop">Decision</p>
  <h3 class="decision__title">{title}</h3>
  <div class="decision__body">
    <slot />
  </div>
  <p class="decision__tradeoff"><strong>Trade-off:</strong> {tradeoff}</p>
</aside>

<style>
  .decision {
    /* Printed on the prose sheet: a tint and a colour band, no frame. */
    background: var(--surface-2);
    margin-block: var(--space-5);
    overflow: hidden;
  }

  .decision__eyebrow {
    display: block;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 650;
    color: var(--ink);
    background: var(--green);
  }

  .decision__title {
    font-size: var(--text-lg);
    margin: 0;
    padding: var(--space-5) var(--space-5) 0;
  }

  .decision__body {
    margin-block-start: var(--space-4);
    padding-inline: var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .decision__body :global(p) {
    max-width: 56ch;
  }

  .decision__tradeoff {
    margin: var(--space-4) var(--space-5) 0;
    padding-block: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
  }
</style>
