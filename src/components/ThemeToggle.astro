<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch to dark theme"
  title="Switch theme"
>
  <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2"></path>
      <path d="M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"></path>
    </g>
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      d="M20.5 14.4A8.6 8.6 0 0 1 9.6 3.5a8.6 8.6 0 1 0 10.9 10.9Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function currentTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function label(theme: 'light' | 'dark') {
    if (!button) return;
    const next = theme === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
    button.dataset.current = theme;
  }

  label(currentTheme());

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode — the toggle still works for this page view */
    }
    label(next);
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    border: 2px solid var(--ink);
    background: var(--surface);
    color: var(--text-muted);
    box-shadow: var(--shadow-key-sm);
    transition:
      transform var(--duration-1) var(--ease),
      box-shadow var(--duration-1) var(--ease),
      color var(--duration-1) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--text);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--shadow-ink);
  }

  .theme-toggle:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--shadow-ink);
  }

  .icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .icon--moon {
    display: none;
  }

  :global([data-theme='dark']) .icon--sun {
    display: none;
  }

  :global([data-theme='dark']) .icon--moon {
    display: block;
  }
</style>
