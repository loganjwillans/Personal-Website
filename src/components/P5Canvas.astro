---
import { markerStyle, viewName } from '@/lib/tilt';

interface Props {
  src: string;
  poster: string;
  title: string;
}

const { src, poster, title } = Astro.props;
const vtName = viewName(Astro.url.pathname, 'sketch');
---

<div class="sketch" data-sketch data-src={src} data-title={title} style={`--vt-name: ${vtName}`}>
  <div class="sketch__stage">
    <img
      class="sketch__poster"
      src={poster}
      alt=""
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    <div class="sketch__overlay" data-sketch-overlay>
      <button
        class="button button--primary sketch__play"
        type="button"
        data-sketch-play
        style={markerStyle(`sketch:${title}:play`)}
      >
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
          <path d="M4 2.6 13 8l-9 5.4Z" fill="currentColor"></path>
        </svg>
        Play sketch
      </button>
      <p class="sketch__note">Runs live in the page. Nothing plays until you ask it to.</p>
    </div>
  </div>

  <div class="sketch__controls object" data-sketch-controls hidden>
    <span class="sketch__status">Running</span>
    <button
      class="button button--quiet"
      type="button"
      data-sketch-stop
      style={markerStyle(`sketch:${title}:stop`)}
    >
      Stop
    </button>
  </div>
</div>

<script>
  // Bundled scripts run once per document; bind again on every page load so the
  // sketch still plays after a client-side navigation.
  function init() {
    const sketch = document.querySelector<HTMLElement>('[data-sketch]');
    if (!sketch) return;

    const stage = sketch.querySelector<HTMLElement>('.sketch__stage');
    const overlay = sketch.querySelector<HTMLElement>('[data-sketch-overlay]');
    const controls = sketch.querySelector<HTMLElement>('[data-sketch-controls]');
    const play = sketch.querySelector<HTMLButtonElement>('[data-sketch-play]');
    const stop = sketch.querySelector<HTMLButtonElement>('[data-sketch-stop]');
    const src = sketch.dataset.src;
    const title = sketch.dataset.title ?? 'Generative sketch';

    let frame: HTMLIFrameElement | null = null;

    play?.addEventListener('click', () => {
      if (!stage || !src) return;

      frame = document.createElement('iframe');
      frame.src = src;
      frame.title = `${title} — live sketch`;
      frame.loading = 'eager';
      frame.setAttribute('allow', 'autoplay');
      stage.prepend(frame);

      if (overlay) overlay.hidden = true;
      if (controls) controls.hidden = false;
      stop?.focus();
    });

    stop?.addEventListener('click', () => {
      frame?.remove();
      frame = null;
      if (overlay) overlay.hidden = false;
      if (controls) controls.hidden = true;
      play?.focus();
    });
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .sketch {
    display: grid;
    gap: var(--space-4);
  }

  .sketch__stage {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--scrim);
  }

  .sketch__poster,
  .sketch__stage iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .sketch__poster {
    object-fit: cover;
  }

  .sketch__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-5);
    text-align: center;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--scrim) 86%, transparent),
      color-mix(in srgb, var(--scrim) 38%, transparent)
    );
    color: var(--on-scrim);
  }

  .sketch__note {
    font-size: var(--text-xs);
    color: var(--on-scrim);
    opacity: 0.85;
    max-width: 32ch;
  }

  .sketch__play {
    /* The overlay is always a dark scrim, so the button's rule is the scrim's
       own ink rather than the page ink. */
    border-color: var(--on-scrim);
  }

  .sketch__play svg {
    margin-inline-end: 0.4em;
  }

  .sketch__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }

  .sketch__status {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 600;
  }
</style>
