---
import LockIcon from '@/components/LockIcon.astro';
import { site } from '@/config';

interface Props {
  slug: string;
  passwordEnv: string;
}

const { slug, passwordEnv } = Astro.props;
const inputId = `password-${slug}`;
const helpId = `password-help-${slug}`;
const errorId = `password-error-${slug}`;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(site.accessRequestSubject)}`;
---

<div class="protected" data-protected data-slug={slug} data-password-env={passwordEnv}>
  <div class="gate" data-gate>
    <div class="gate__head">
      <span class="lock-badge"><LockIcon size={11} /> Protected</span>
      <h2 class="gate__title">This case study is password protected</h2>
      <p class="gate__intro">
        It contains work that isn't public. Enter the password you were given to read it.
      </p>
    </div>

    <form class="gate__form" data-gate-form novalidate>
      <div class="field">
        <label class="field__label" for={inputId}>Password</label>
        <div class="field__control">
          <input
            id={inputId}
            class="field__input"
            type="password"
            name="password"
            autocomplete="current-password"
            autocapitalize="off"
            spellcheck="false"
            required
            aria-describedby={`${helpId} ${errorId}`}
            data-gate-input
          />
          <button class="field__reveal" type="button" data-reveal aria-pressed="false">
            Show
          </button>
        </div>
        <p class="field__help" id={helpId}>
          Unlocking lasts for this browser session. The content is encrypted, not just hidden.
        </p>
      </div>

      <p class="gate__error" id={errorId} role="alert" aria-live="assertive" data-gate-error hidden>
      </p>

      <button class="button button--primary gate__submit" type="submit" data-gate-submit>
        Unlock case study
      </button>
    </form>

    <p class="gate__foot">
      Need access? <a href={mailto}>Request the password</a>.
    </p>

    {
      import.meta.env.DEV && (
        <p class="gate__dev">
          <button class="button button--quiet" type="button" data-dev-unlock>
            Dev only: preview without a password
          </button>
        </p>
      )
    }

    <noscript>
      <p class="gate__error">
        This page needs JavaScript to decrypt its content. Email
        <a href={mailto}>{site.email}</a> and I'll send you a PDF.
      </p>
    </noscript>
  </div>

  <div class="unlocked-bar" data-unlocked-bar hidden>
    <span class="lock-badge"><LockIcon size={11} /> Unlocked for this session</span>
    <button class="button button--quiet" type="button" data-lock>Lock page</button>
  </div>

  <template data-protected-source><div class="prose"><slot /></div></template>

  <div class="protected__content" data-protected-output tabindex="-1" hidden></div>
</div>

<script>
  import {
    base64ToBytes,
    bytesToBase64,
    decryptWithKey,
    decryptWithPassword,
    exportRawKey,
    type EncryptedPayload,
  } from '@/lib/crypto';

  const root = document.querySelector<HTMLElement>('[data-protected]');

  if (root) {
    const gate = root.querySelector<HTMLElement>('[data-gate]');
    const form = root.querySelector<HTMLFormElement>('[data-gate-form]');
    const input = root.querySelector<HTMLInputElement>('[data-gate-input]');
    const submit = root.querySelector<HTMLButtonElement>('[data-gate-submit]');
    const errorEl = root.querySelector<HTMLElement>('[data-gate-error]');
    const reveal = root.querySelector<HTMLButtonElement>('[data-reveal]');
    const devUnlock = root.querySelector<HTMLButtonElement>('[data-dev-unlock]');
    const output = root.querySelector<HTMLElement>('[data-protected-output]');
    const bar = root.querySelector<HTMLElement>('[data-unlocked-bar]');
    const lockButton = root.querySelector<HTMLButtonElement>('[data-lock]');
    const template = root.querySelector<HTMLTemplateElement>('template[data-protected-source]');
    const payloadEl = root.querySelector<HTMLScriptElement>('#protected-payload');

    const slug = root.dataset.slug ?? 'case-study';
    const storageKey = `brainvat:unlocked:${slug}`;

    let payload: EncryptedPayload | null = null;
    if (payloadEl?.textContent) {
      try {
        payload = JSON.parse(payloadEl.textContent) as EncryptedPayload;
      } catch {
        payload = null;
      }
    }

    function setError(message: string | null) {
      if (!errorEl) return;
      errorEl.textContent = message ?? '';
      errorEl.hidden = !message;
      if (input) input.setAttribute('aria-invalid', message ? 'true' : 'false');
    }

    function setBusy(busy: boolean) {
      if (!submit) return;
      submit.disabled = busy;
      submit.textContent = busy ? 'Unlocking…' : 'Unlock case study';
      root?.setAttribute('aria-busy', busy ? 'true' : 'false');
    }

    function show(html: string) {
      if (!output) return;
      output.innerHTML = html;
      output.hidden = false;
      if (gate) gate.hidden = true;
      if (bar) bar.hidden = false;
      setError(null);
      output.focus({ preventScroll: true });
    }

    function lock() {
      try {
        sessionStorage.removeItem(storageKey);
      } catch {
        /* storage unavailable — nothing persisted anyway */
      }
      if (output) {
        output.innerHTML = '';
        output.hidden = true;
      }
      if (bar) bar.hidden = true;
      if (gate) gate.hidden = false;
      if (input) {
        input.value = '';
        input.focus();
      }
    }

    // --- Restore an earlier unlock in this session -------------------------
    if (payload) {
      let saved: string | null = null;
      try {
        saved = sessionStorage.getItem(storageKey);
      } catch {
        saved = null;
      }

      if (saved) {
        void decryptWithKey(payload, base64ToBytes(saved)).then((html) => {
          if (html) show(html);
          else {
            try {
              sessionStorage.removeItem(storageKey);
            } catch {
              /* ignore */
            }
          }
        });
      }
    }

    // --- Reveal / hide the password ---------------------------------------
    reveal?.addEventListener('click', () => {
      if (!input) return;
      const revealed = input.type === 'text';
      input.type = revealed ? 'password' : 'text';
      reveal.textContent = revealed ? 'Show' : 'Hide';
      reveal.setAttribute('aria-pressed', revealed ? 'false' : 'true');
      input.focus();
    });

    // --- Unlock ------------------------------------------------------------
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!input || !payload) return;

      const password = input.value;
      if (password.trim() === '') {
        setError('Enter the password you were given.');
        input.focus();
        return;
      }

      setBusy(true);
      setError(null);

      const result = await decryptWithPassword(payload, password, true);

      if (!result) {
        setBusy(false);
        setError("That password doesn't match. Check for typos and try again.");
        input.select();
        return;
      }

      try {
        const raw = await exportRawKey(result.key);
        sessionStorage.setItem(storageKey, bytesToBase64(raw));
      } catch {
        /* the page stays unlocked until reload */
      }

      setBusy(false);
      show(result.html);
    });

    // --- Dev preview -------------------------------------------------------
    devUnlock?.addEventListener('click', () => {
      const html = template?.innerHTML ?? '';
      if (html) show(html);
    });

    lockButton?.addEventListener('click', lock);
  }
</script>

<style>
  .protected {
    margin-block-start: var(--space-6);
  }

  .gate {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    max-width: 34rem;
    box-shadow: var(--shadow-sm);
  }

  .gate__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .gate__title {
    font-size: var(--text-xl);
  }

  .gate__intro {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: 46ch;
  }

  .gate__form {
    margin-block-start: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field__label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .field__control {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg);
    overflow: hidden;
    transition: border-color var(--duration-1) var(--ease);
  }

  .field__control:focus-within {
    border-color: var(--accent);
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .field__input {
    flex: 1;
    min-width: 0;
    padding: 0.65em 0.85em;
    border: 0;
    background: transparent;
    font-size: var(--text-base);
  }

  .field__input:focus-visible {
    outline: none;
  }

  .field__input[aria-invalid='true'] {
    color: var(--danger);
  }

  .field__reveal {
    padding-inline: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    border-inline-start: 1px solid var(--border);
  }

  .field__reveal:hover {
    color: var(--text);
  }

  .field__help {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .gate__error {
    font-size: var(--text-sm);
    color: var(--danger);
    font-weight: 500;
  }

  .gate__submit {
    justify-self: start;
  }

  .gate__submit:disabled {
    opacity: 0.65;
    cursor: progress;
  }

  .gate__foot {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .gate__dev {
    margin-block-start: var(--space-2);
  }

  .unlocked-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-end: var(--space-4);
    margin-block-end: var(--space-2);
    border-block-end: 1px solid var(--border);
  }

  .protected__content:focus-visible {
    outline: none;
  }
</style>
